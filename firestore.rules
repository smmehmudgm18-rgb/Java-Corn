rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // সবাই ভিডিও/সিরিজ/ট্যাগ পড়তে পারবে (পাবলিক সাইট)
    // কিন্তু লেখা/এডিট/ডিলিট শুধু লগইন করা অ্যাডমিন (তুমি) করতে পারবে
    match /videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /series/{seriesId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
